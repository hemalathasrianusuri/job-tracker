ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_tracker
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:3000

# AI providers — defaults to a fully free stack (Gemini primary, Groq
# fallback). Get free keys at aistudio.google.com/apikey and
# console.groq.com/keys — neither requires a credit card. Set
# AI_PRIMARY_PROVIDER/AI_FALLBACK_PROVIDER to "claude"/"openai" instead if
# you'd rather use a paid provider.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
